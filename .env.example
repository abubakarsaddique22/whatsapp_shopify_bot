# Copy this file to .env and fill in real values. NEVER commit .env to Git.

# --- app ---
APP_ENV=local
LOG_LEVEL=INFO
KILL_SWITCH=false
# admin endpoints stay off. To turn them on you need a random key of 24+ characters
ADMIN_API_KEY=
ADMIN_ENDPOINTS_ENABLED=false
# secret salt for hashing phone numbers in logs and traces: use a long random value
PHONE_HASH_PEPPER=change-me-random

# --- database ---
DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/bot

# --- shopify (read-only) ---
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_AUTH_MODE=client_credentials
SHOPIFY_OFFLINE_TOKEN=
# public https address of this server, no path (your tunnel URL); used by scripts\register_webhooks.py
SHOPIFY_WEBHOOK_BASE_URL=
# how often the reconciliation loop runs (python -m app.jobs.reconcile --loop)
RECONCILE_DELTA_MINUTES=5
RECONCILE_POLICY_MINUTES=60
RECONCILE_FULL_HOURS=24
LOW_STOCK_THRESHOLD=3
SHOW_EXACT_STOCK=false
LIVE_STOCK_CACHE_SECONDS=0

# --- whatsapp ---
META_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me-random
MAX_AUDIO_SECONDS=90
MAX_AUDIO_BYTES=5000000

# --- llm ---
LLM_PROVIDER=
ROUTER_MODEL=
COMPOSER_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
# time budget of ONE customer message in the graph: after this no new composer call starts
TURN_BUDGET_SECONDS=45

# --- eval only (Ollama): used by `eval-router`; local = no key needed, cloud = real key ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
EVAL_ROUTER_MODEL=gpt-oss:120b-cloud

# --- speech ---
STT_PROVIDER=fake
STT_API_KEY=
# Groq Whisper: whisper-large-v3 (more accurate) or whisper-large-v3-turbo (cheaper, faster)
STT_MODEL=whisper-large-v3
STT_TIMEOUT_SECONDS=30
STT_MIN_CONFIDENCE=0.0
STT_MIN_WORDS=2
# local development only: with STT_PROVIDER=fake every voice note "says" this text
STT_FAKE_TEXT=

# --- embeddings / rag ---
# fake (tests) | sentence-transformers (local model, no key)
# The model chosen and measured with `rag-eval` (2026-10-16): paraphrase-multilingual-MiniLM-L12-v2
# (about 470 MB). EMBEDDING_MODEL empty = BAAI/bge-m3 (about 2.2 GB, not measured yet).
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
RAG_MIN_SCORE=0.40

# --- language ---
URDU_SCRIPT_REPLIES=false
LANGUAGE_STICKY_MESSAGES=5
# Phase 5 development only: the bot replies with what the router understood. Keep false.
DEBUG_REPLY=false

# --- rate limits ---
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_HOUR=60
RATE_LIMIT_PER_DAY=200
# daily LLM + speech spend in your currency; alarm at 80 %, handoff-only at 100 %. 0 = off
DAILY_COST_BUDGET=0

# --- retention (days) --- run `uv run python -m app.jobs.retention` once a day
# a customer silent for RETENTION_CONVERSATION_DAYS is erased completely (phone number included)
RETENTION_CONVERSATION_DAYS=180
RETENTION_MESSAGE_DAYS=90
RETENTION_QUEUE_DAYS=30
RETENTION_HANDOFF_DAYS=90
RETENTION_SECURITY_DAYS=365
RETENTION_SYNC_DAYS=14
RETENTION_CHECKPOINT_DAYS=7

# --- handoff ---
# email | slack | whatsapp_staff | log   ('log' only prints the notification, for local use)
HANDOFF_CHANNEL=email
# who gets the notification. email: address(es), comma separated | slack: the incoming-webhook
# URL (a secret, never commit it) | whatsapp_staff: the staff number, digits only | log: unused
HANDOFF_TARGET=
HANDOFF_PAUSE_HOURS=12
# local time, HH:MM-HH:MM
BUSINESS_HOURS=10:00-20:00
# the time zone of BUSINESS_HOURS as an offset from UTC (Pakistan = +05:00)
BUSINESS_UTC_OFFSET=+05:00
# HANDOFF_CHANNEL=email only. Port 587 = STARTTLS, 465 = SSL. Empty SMTP_FROM = SMTP_USER.
# Gmail: smtp.gmail.com + an app password (not the normal password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- observability ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=wa-shopify-bot-dev
